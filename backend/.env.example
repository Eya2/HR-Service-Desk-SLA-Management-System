# Copy to .env (next to docker-compose.yml) and adjust. Never commit .env.
POSTGRES_DB=hrdesk
POSTGRES_USER=hrdesk
POSTGRES_PASSWORD=change-me
ASPNETCORE_ENVIRONMENT=Development

# Access token signing key (HMAC-SHA256), at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-long-random-value-of-32-chars-or-more
# Password of every seeded demo account (12+ chars, upper, lower, digit, symbol)
SEED_PASSWORD=change-me

# Encrypts webhook signing secrets in the database. Generate one with: openssl rand -base64 32
INTEGRATION_SECRET_KEY=change-me-to-a-long-random-value
# Demo payroll connector: an API key (hrd_<8 chars>_<random>) and a webhook secret shared with the mock-payroll container.
# Generate with: echo "hrd_$(openssl rand -hex 4)_$(openssl rand -hex 24)"  and  echo "whsec_$(openssl rand -hex 24)"
PAYROLL_API_KEY=hrd_demopay1_change-me-to-a-random-value
PAYROLL_WEBHOOK_SECRET=whsec_change-me

# Host ports
API_PORT=5080
POSTGRES_PORT=5432
MAILHOG_UI_PORT=8025
MOCK_PAYROLL_PORT=8090
