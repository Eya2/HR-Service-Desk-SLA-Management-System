{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=hrdesk;Username=hrdesk;Password=hrdesk"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Swagger": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Logging": {
    "Json": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Jwt": {
    "Issuer": "hr-service-desk",
    "Audience": "hr-service-desk",
    "SigningKey": ""
  },
  "Auth": {
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "7.00:00:00",
    "MaxFailedLoginAttempts": 5,
    "LockoutDuration": "00:15:00"
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Seed": {
    "Enabled": false,
    "DemoPassword": ""
  },
  "Attachments": {
    "MaxFileSizeBytes": 10485760,
    "MaxFilesPerRequest": 10
  },
  "Storage": {
    "RootPath": "data/attachments"
  },
  "BackgroundJobs": {
    "Enabled": false,
    "Dashboard": false
  },
  "Smtp": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 1025,
    "From": "HR Service Desk <no-reply@hr-service-desk.local>",
    "AppUrl": "http://localhost:8080"
  },
  "AllowedHosts": "*"
}
